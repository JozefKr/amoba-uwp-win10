<local:BasePage
    x:Class="Amoba.Views.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Amoba.Converters"
    mc:Ignorable="d"
    xmlns:local="using:Amoba.Views"
    x:Name="PageRoot"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Konverterek és Stílusok -->
        <conv:PlacesToDimensionsConverter x:Key="placesToDimensions" />
        <conv:TurnToColorConverter x:Key="turnToColor"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:BooleanToAlignmentConverter x:Key="BoolToAlignmentConverter" />
        <conv:BooleanToBrushConverter x:Key="ChatBubbleColorConverter"
                                  TrueBrush="{StaticResource MyChatBubbleBrush}"
                                  FalseBrush="{StaticResource OpponentChatBubbleBrush}" />

        <!-- A WinningBrush-t most már Page.Resources-ben definiáljuk,
             hogy a VSM használhassa. -->
        <SolidColorBrush x:Key="WinningBrushColor" Color="#FFD700" Opacity="0.75" />
        <SolidColorBrush x:Key="MyChatBubbleBrush" Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="OpponentChatBubbleBrush" Color="#4A4A4A"/> <!-- Középszürke -->
        <Storyboard x:Name="PopInStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CellImage"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0" Duration="0:0:0.250" />
            <DoubleAnimation
                Storyboard.TargetName="CellImageScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.7" To="1.0" Duration="0:0:0.250">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CellImageScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.7" To="1.0" Duration="0:0:0.250">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>


        <Style x:Key="GameBoardButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundBaseLowBrush}" />

            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                            <!-- A VSM továbbra is felülírja a hátteret PointerOver/Pressed esetén -->
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SystemControlHighlightBaseMediumLowBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SystemControlHighlightBaseMediumBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
                                            <Setter Target="RootBorder.Opacity" Value="0.5"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>

                                <!-- ======================================================= -->
                                <!-- A nyerő cella kiemelése VSM-mel (Ez a tiszta megoldás) -->
                                <!-- ======================================================= -->
                                <VisualStateGroup x:Name="WinningStates">
                                    <VisualState x:Name="NotWinning" />
                                    <VisualState x:Name="Winning">
                                        <!-- Ha az IsWinningCell TRUE, ez a VisualState aktív lesz -->
                                        <VisualState.StateTriggers>
                                            <!-- Ez a DataTrigger a gomb Adatkontextusát (a Place-t) figyeli -->
                                            <StateTrigger IsActive="{Binding IsWinningCell}"/>
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <!-- Közvetlenül felülírja a RootBorder hátterét az arany színnel -->
                                            <Setter Target="RootBorder.Background" Value="{StaticResource WinningBrushColor}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <!-- Az 'Image' (X/O) -->
                            <Image x:Name="CellImage"
                                Source="{Binding Image}" 
                                Stretch="Uniform" 
                                Margin="5"
                                Opacity="1.0"
                                RenderTransformOrigin="0.5, 0.5"
                                SizeChanged="CellImage_SizeChanged">

                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="CellImageScale" ScaleX="1.0" ScaleY="1.0" />
                                </Image.RenderTransform>
                            </Image>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar Background="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}" 
                    Opacity="0.9"
                    ClosedDisplayMode="Compact">
            <AppBarButton Icon="Refresh" 
                          Label="Visszavágó" 
                          Command="{Binding NewGameCommand}"
                          IsEnabled="{Binding IsGameOver}"/>
            <AppBarButton Icon="Home" 
                          Label="Főmenü" 
                          Command="{Binding MainMenuCommand}"/>
        </CommandBar>
    </Page.BottomAppBar>
    
    <Grid x:Name="RootGrid" Padding="20">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>

                <!-- KESKENY NÉZET (MOBIL) - Alapértelmezett -->
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <!-- Nincsenek Setterek, az alapértelmezett (alul definiált) elrendezést használjuk -->
                </VisualState>

                <!-- SZÉLES NÉZET (ASZTALI) -->
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- 1. A fő tartalom (Grid.Row="1") most már vízszintes lesz -->
                        <Setter Target="GameAndChatGrid.Orientation" Value="Horizontal"/>
                        <Setter Target="GameAndChatGrid.VerticalAlignment" Value="Center"/>

                        <!-- 2. A ChatPanel-t 300px szélesre állítjuk -->
                        <Setter Target="ChatPanel.Width" Value="300"/>
                        <!-- 3. A ChatPanel magasságát "kitöltőre" állítjuk -->
                        <Setter Target="ChatPanel.Height" Value="Auto"/>
                        <Setter Target="ChatPanel.VerticalAlignment" Value="Stretch"/>
                        <Setter Target="ChatPanel.MaxWidth" Value="600"/>
                        <!-- Fixáljuk a szélességet -->

                        <!-- 4. Az elválasztó (Separator) látható lesz -->
                        <Setter Target="Separator.Visibility" Value="Visible"/>

                        <!-- 5. Az elválasztó átváltása függőlegesre -->
                        <Setter Target="Separator.Width" Value="1"/>
                        <Setter Target="Separator.Height" Value="Auto"/>
                        <!-- Kitölti a magasságot -->
                        <Setter Target="Separator.Margin" Value="20,0"/>

                        <!-- 6. A Játéktábla Viewbox-a igazodik -->
                        <Setter Target="BoardViewbox.VerticalAlignment" Value="Center"/>

                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. sor: Pontszámláló VAGY Game Over -->
            <RowDefinition Height="*"/>
            <!-- 1. sor: A fő tartalom (Játék + Chat) -->
        </Grid.RowDefinitions>

        <!-- ======================================================= -->
        <!-- 0. SOR: PONTSZÁMLÁLÓ / GAME OVER SÁV (Egymást váltva) -->
        <!-- ======================================================= -->
        <Grid Grid.Row="0">

            <!-- 1A. PONTSZÁMLÁLÓ (MECCS KÖZBEN) -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,10"
                  Visibility="{Binding IsGameInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.Transitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                    </TransitionCollection>
                </Grid.Transitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,40,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding MyPlayerName, FallbackValue='JÁTÉKOS (X)'}" 
                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" 
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding MyPlayerScore}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Ellipse Height="10" Width="10" Fill="{Binding IsPlayer1Turn, Converter={StaticResource turnToColor}}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock Text="VS" Grid.Column="1" FontSize="32" FontWeight="Light" VerticalAlignment="Center" Margin="0,0,0,10" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <StackPanel Grid.Column="2" Margin="40,0,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding OpponentName, FallbackValue='JÁTÉKOS (O)'}" 
                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" 
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding OpponentPlayerScore}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Ellipse Height="10" Width="10" Fill="{Binding IsPlayer2Turn, Converter={StaticResource turnToColor}}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 1B. "GAME OVER" PANEL (MECCS VÉGÉN) -->
            <StackPanel 
                Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" 
                Margin="0,0,0,10" 
                Padding="15,10"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="5"
                BorderThickness="1"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                Visibility="{Binding IsGameOver, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel.Transitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                    </TransitionCollection>
                </StackPanel.Transitions>
                <TextBlock x:Name="GameOverMessageText"
                           Text="{Binding GameOverMessage}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           FontSize="18" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- ======================================================= -->
        <!-- 1. SOR: JÁTÉK ÉS CHAT TARTALOM (RESZPONZÍVAN) -->
        <!-- ======================================================= -->

        <!-- Ez most egy StackPanel, ami középre igazítja
             az asztali nézetet (Horizontal), és kitölti mobilon (Vertical).
             A VerticalAlignment="Top" mobilon biztosítja, hogy a tartalom
             felül kezdődjön, és a chatpanel ne csússzon le. -->
        <StackPanel x:Name="GameAndChatGrid" Grid.Row="1" Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Vertical">
            <!-- Alapértelmezett (Mobil) tájolás -->

            <!-- 1A. JÁTÉKTÁBLA (Mindig látszik) -->
            <Viewbox x:Name="BoardViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
                <ItemsControl
                    x:Name="GameBoard"
                    ItemsSource="{Binding Places}"
                    Width="{Binding BoardSize, Converter={StaticResource placesToDimensions}}"
                    Height="{Binding BoardSize, Converter={StaticResource placesToDimensions}}"
                    Background="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                Orientation="Horizontal"
                                MaximumRowsOrColumns="{Binding BoardSize}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="80" Height="80"
                                Style="{StaticResource GameBoardButtonStyle}"
                                Command="{Binding DataContext.SetImage, ElementName=PageRoot}"
                                CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Viewbox>

            <!-- Elválasztó vonal (Mobilon rejtett) -->
            <Rectangle x:Name="Separator" 
                       Width="Auto" Height="1" 
                       Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" 
                       Margin="0,10" 
                       Visibility="Collapsed"/>
            <!-- Alapból rejtett, csak széles nézetben látszik -->

            <!-- 1B. CHAT FELÜLET -->
            <Grid x:Name="ChatPanel" 
                  Margin="0,10,0,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Height="170"
                  Width="Auto"
                  MinWidth="300"
                  MaxWidth="800"
                  Visibility="{Binding IsNetworkGame, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Cím -->
                    <RowDefinition Height="*"/> <!-- Előzmények -->
                    <RowDefinition Height="Auto"/> <!-- Gépelési jelző -->
                    <RowDefinition Height="Auto"/> <!-- Beviteli mező -->
                </Grid.RowDefinitions>

                <!-- Chat Cím -->
                <TextBlock Grid.Row="0" Text="CSEVEGÉS" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,10"/>

                <!-- Chat Előzmények (ListView) -->
                <ListView Grid.Row="1" 
                          x:Name="ChatHistoryListView"
                          ItemsSource="{Binding ChatHistory}"
                          Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                          SelectionMode="None" 
                          IsItemClickEnabled="False">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="2,4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlignmentConverter}}"
                                  MaxWidth="240">
                                <Border Background="{Binding IsMine, Converter={StaticResource ChatBubbleColorConverter}}"
                                        CornerRadius="5"
                                        Padding="8">
                                    <TextBlock 
                                        Text="{Binding DisplayMessage}" 
                                        TextWrapping="WrapWholeWords" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="2" 
                           Margin="5,2,5,2"
                           FontStyle="Italic"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           Visibility="{Binding IsOpponentTyping, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="{Binding OpponentName, FallbackValue='Ellenfél'}"/>
                    <Run Text=" épp ír..."/>
                </TextBlock>

                <!-- Beviteli Mező és Gomb -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="ChatInputBox"
                             PlaceholderText="Írj üzenetet..."
                             Text="{Binding ChatMessageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="0,0,5,0"
                             KeyUp="ChatInputBox_KeyUp"
                             TextChanged="ChatInputBox_TextChanged"/>

                    <Button Grid.Column="1"
                            x:Name="SendChatButton"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE724;" 
                            Command="{Binding SendChatCommand}"
                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                            Foreground="White"/>
                </Grid>
            </Grid>

        </StackPanel>

        <!-- A rejtett MediaElement-ek -->
        <StackPanel Height="0" Opacity="0">
            <MediaElement x:Name="ClickSound" Source="ms-appx:///Assets/Sounds/click.mp3" AutoPlay="False" />
            <MediaElement x:Name="WinSound" Source="ms-appx:///Assets/Sounds/win.mp3" AutoPlay="False" />
            <MediaElement x:Name="LoseSound" Source="ms-appx:///Assets/Sounds/lose.mp3" AutoPlay="False" />
        </StackPanel>

    </Grid>
</local:BasePage>