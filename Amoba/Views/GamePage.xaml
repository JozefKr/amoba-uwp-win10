<Page
    x:Class="Amoba.Views.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    
    xmlns:conv="using:Amoba.Converters"  
    xmlns:local="using:Amoba.Views"
    
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Konverterek regisztrálása -->
        <conv:PlacesToDimensionsConverter x:Key="placesToDimensions" />
        <conv:TurnToColorConverter x:Key="turnToColor" />
    </Page.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- 1. Játéktábla (ItemsControl) -->
            <ItemsControl 
                ItemsSource="{Binding Places}" 
                Background="#808080" 
 
                Width="{Binding Places, Converter={StaticResource placesToDimensions}}" 
                Height="{Binding Places, Converter={StaticResource placesToDimensions}}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid 
                            Orientation="Horizontal" 
                            MaximumRowsOrColumns="{Binding GameSize}" />
                        <!-- A MaximumRowsOrColumns beállítása szükséges a rács méretéhez -->
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button 
                            Width="80" Height="80" Margin="5" 
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            
                            Command="{Binding DataContext.SetImage, ElementName=PageRoot}"
                            CommandParameter="{Binding}"
                            
                            Style="{StaticResource DefaultButtonStyle}">

                            <!-- Eredeti Button.Background, ami ImageBrush-t használ -->
                            <Button.Background>
                                <ImageBrush ImageSource="{Binding Image}" Stretch="Uniform" />
                            </Button.Background>
                            <Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 2. Pontszám kijelzése -->
            <StackPanel VerticalAlignment="Center" Margin="30,0,10,0">
                <!-- Játékos 1 -->
                <TextBlock Text="Player 1" FontSize="20" FontWeight="Bold"
                           Foreground="{Binding IsPlayer1Turn, Converter={StaticResource turnToColor}}"/>
                <TextBlock Text="{Binding Player1Score}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                <!-- Játékos 2 -->
                <TextBlock Text="Player 2" FontSize="20" FontWeight="Bold"
                           Foreground="{Binding IsPlayer2Turn, Converter={StaticResource turnToColor}}"/>
                <TextBlock Text="{Binding Player2Score}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>