<local:BasePage
    x:Class="Amoba.Views.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Amoba.Converters"
    mc:Ignorable="d"
    xmlns:local="using:Amoba.Views"
    x:Name="PageRoot"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Konverterek és Stílusok (Változatlan) -->
        <conv:PlacesToDimensionsConverter x:Key="placesToDimensions" />
        <conv:TurnToColorConverter x:Key="turnToColor"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="GameBoardButtonStyle" TargetType="Button">
            <!-- ... A gomb stílusod (változatlan) ... -->
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SystemControlHighlightBaseMediumLowBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SystemControlHighlightBaseMediumBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
                                            <Setter Target="RootBorder.Opacity" Value="0.5"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Image Source="{Binding Image}" Stretch="Uniform" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.BottomAppBar>

        <CommandBar Background="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}" 
                    Opacity="0.9"
                    ClosedDisplayMode="Compact">
            <AppBarButton Icon="Home" 
                          Label="Főmenü" 
                          Command="{Binding MainMenuCommand}"
                          IsEnabled="{Binding IsGameInProgress}"/>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. sor: Pontszámláló ÉS az új értesítő sáv -->
            <RowDefinition Height="*"/>
            <!-- 1. sor: Játéktábla -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,40,0" HorizontalAlignment="Right">
                    <TextBlock Text="JÁTÉKOS (X)" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding Player1Score}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Ellipse Height="10" Width="10" Fill="{Binding IsPlayer1Turn, Converter={StaticResource turnToColor}}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock Text="VS" Grid.Column="1" FontSize="32" FontWeight="Light" VerticalAlignment="Center" Margin="0,0,0,10" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                <StackPanel Grid.Column="2" Margin="40,0,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding OpponentName, FallbackValue='JÁTÉKOS (O)'}" 
                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" 
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding Player2Score}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Ellipse Height="10" Width="10" Fill="{Binding IsPlayer2Turn, Converter={StaticResource turnToColor}}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel 
                Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                Padding="15,10"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="5"
                BorderThickness="1"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"

                Visibility="{Binding IsGameOver, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!-- A győzelmi üzenet -->
                <TextBlock x:Name="GameOverMessageText"
                           Text="{Binding GameOverMessage}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           FontSize="18" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

        </StackPanel>

        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
            <ItemsControl
                x:Name="GameBoard"
                ItemsSource="{Binding Places}"
                Width="{Binding BoardSize, Converter={StaticResource placesToDimensions}}"
                Height="{Binding BoardSize, Converter={StaticResource placesToDimensions}}"
                Background="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            Orientation="Horizontal"
                            MaximumRowsOrColumns="{Binding BoardSize}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Width="80" Height="80"
                            Style="{StaticResource GameBoardButtonStyle}"
                            Command="{Binding DataContext.SetImage, ElementName=PageRoot}"
                            CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>
    </Grid>
</local:BasePage>