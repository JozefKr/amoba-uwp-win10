<local:BasePage
    x:Class="Amoba.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Amoba.Converters"
    mc:Ignorable="d"
    xmlns:local="using:Amoba.Views"
    x:Name="PageRoot"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- ... (A konverterek és animációk (Storyboard) változatlanok) ... -->
        <conv:PlacesToDimensionsConverter x:Key="placesToDimensions"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <Storyboard x:Name="FadeOutLogoStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="LogoContainer"
                Storyboard.TargetProperty="Opacity"
                From="1.0" To="0.0" Duration="0:0:0.5" />
            <ObjectAnimationUsingKeyFrames
                Storyboard.TargetName="LogoContainer"
                Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.5">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Collapsed</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Name="FadeInMenuStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="MenuStackPanel"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0" Duration="0:0:1"/>
        </Storyboard>

    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Viewbox 
            x:Name="LogoContainer"
            Grid.Row="0"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            MaxWidth="300" 
            MaxHeight="300"
            Margin="0,0,0,20">
            <Image x:Name="LogoImage" 
                   Source="ms-appx:///Assets/Images/game_logo.png" 
                   Stretch="Uniform" 
                   Opacity="1.0" />
        </Viewbox>

        <StackPanel x:Name="MenuStackPanel"
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Margin="20,0"
                    MaxWidth="400"
                    Opacity="0.0"
                    Visibility="Visible">

            <TextBlock Text="Amőba" 
                       Style="{ThemeResource HeaderTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

            <Button
                x:Name="StartLocalPvpButton" 
                Content="Játék Barát Ellen (Helyi)" 
                FontSize="18" 
                Margin="0,0,0,10" 
                Command="{Binding StartLocalPvpCommand}"
                MinHeight="50"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                Foreground="White"/>

            <Button
                x:Name="StartAiButton" 
                Content="Játék Gép Ellen (AI)" 
                FontSize="18" 
                Margin="0,0,0,30" 
                Command="{Binding StartAiGameCommand}"
                MinHeight="50"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                Foreground="White"/>

            <TextBlock Text="— Hálózati játék —" 
                       Style="{ThemeResource BaseTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

            <TextBox Header="Játékosneved" 
                Margin="0,0,0,20"
                FontSize="18"
                PlaceholderText="Pl. Pista"
                Text="{Binding PlayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding IsNameEntryEnabled}"/>

            <Button
                x:Name="startHostingButton" 
                Content="Játék Hostolása (Légy Te a Szerver)" 
                FontSize="16" 
                Margin="0,0,0,10" 
                Command="{Binding StartHostingCommand}"
                Visibility="{Binding IsInMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsEnabled="{Binding IsNetworkReady}"
                HorizontalAlignment="Stretch"
                MinHeight="40" />

            <Button
                x:Name="startDiscoveryButton" 
                Content="Játékok Keresése" 
                FontSize="16" 
                Margin="0,0,0,20" 
                Command="{Binding StartDiscoveryCommand}"
                Visibility="{Binding IsInMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsEnabled="{Binding IsNetworkReady}"
                HorizontalAlignment="Stretch"
                MinHeight="40" />

            <ProgressRing IsActive="{Binding IsSearching}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"
                          Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>

            <Button
                x:Name="stopDiscoveryButton" 
                Content="Keresés Leállítása" 
                FontSize="16" 
                Margin="0,0,0,20" 
                Command="{Binding StopDiscoveryCommand}"
                Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Stretch"
                Background="OrangeRed"
                Foreground="White"
                MinHeight="40" />

            <Button
                x:Name="stopHostingButton" 
                Content="Hostolás Leállítása" 
                FontSize="16" 
                Margin="0,0,0,20" 
                Command="{Binding StopHostingCommand}"
                Visibility="{Binding IsHosting, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Stretch"
                Background="OrangeRed"
                Foreground="White"
                MinHeight="40" />

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{Binding StatusMessageBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"
                       Style="{ThemeResource BaseTextBlockStyle}"/>

            <TextBlock Text="Talált Játékok:" 
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Margin="0,0,0,5"/>

            <ListView ItemsSource="{Binding FoundGames}" 
                      MaxHeight="200" 
                      SelectionMode="None"
                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding DisplayName}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource TextBlockButtonStyle}"
                                Command="{Binding DataContext.JoinGameCommand, ElementName=PageRoot}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                Content="Mégse / Csatlakozás Megszakítása"
                FontSize="16"
                Margin="0,20,0,20"
                Command="{Binding CancelJoinCommand}"
                Visibility="{Binding IsJoiningGame, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Stretch"
                Background="OrangeRed"
                Foreground="White"
                MinHeight="40" />
        </StackPanel>
    </Grid>
</local:BasePage>