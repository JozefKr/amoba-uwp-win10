<local:BasePage
    x:Class="Amoba.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:conv="using:Amoba.Converters"
    xmlns:local="using:Amoba.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    
    <Page.Resources>
        <conv:PlacesToDimensionsConverter x:Key="placesToDimensions"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <Storyboard x:Name="FadeOutLogoStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="LogoImage"
                Storyboard.TargetProperty="Opacity"
                From="1.0" To="0.0" Duration="0:0:1" />
            <ObjectAnimationUsingKeyFrames
                Storyboard.TargetName="LogoImage"
                Storyboard.TargetProperty="Visibility"
                BeginTime="0:0:1">
                <DiscreteObjectKeyFrame KeyTime="0">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Collapsed</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>
    <Grid x:Name="RootGrid">
        <Viewbox 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            MaxWidth="400" 
            MaxHeight="400">
            <Image x:Name="LogoImage" 
                Source="ms-appx:///Assets/Images/game_logo.png" 
                Stretch="Uniform" 
                Opacity="1.0" />
        </Viewbox>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Margin="20,0"
                    MaxWidth="400">

            <TextBlock Text="Amőba" 
                       Style="{ThemeResource HeaderTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

            <Button
                x:Name="newgame" 
                Content="Játék indítása (Helyi/AI)" 
                FontSize="20" 
                Margin="0,0,0,30" 
                Command="{Binding StartGame}"
                MinHeight="50"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                Foreground="White" />

            <TextBlock Text="— Hálózati játék —" 
                       Style="{ThemeResource BaseTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            
            <TextBox Header="Játékosneved" 
                Margin="0,0,0,20"
                FontSize="18"
                PlaceholderText="Pl. Pista"
                Text="{Binding PlayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding IsNameEntryEnabled}"/>

            <ProgressRing IsActive="{Binding IsSearching}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,10"
                      Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>

            <Button
                x:Name="startHostingButton" 
                Content="Játék Hostolása (Légy Te a Szerver)" 
                FontSize="16" 
                Margin="0,0,0,10" 
                Command="{Binding StartHostingCommand}"
                Visibility="{Binding IsSearching, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                HorizontalAlignment="Stretch"
                MinHeight="40" />

            <Button
                x:Name="startDiscoveryButton" 
                Content="Játékok Keresése" 
                FontSize="16" 
                Margin="0,0,0,20" 
                Command="{Binding StartDiscoveryCommand}"
                Visibility="{Binding IsSearching, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                HorizontalAlignment="Stretch"
                MinHeight="40" />

            <Button
                x:Name="stopDiscoveryButton" 
                Content="Keresés Leállítása" 
                FontSize="16" 
                Margin="0,0,0,20" 
                Command="{Binding StopDiscoveryCommand}"
                Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Stretch"
                Background="OrangeRed"
                Foreground="White"
                MinHeight="40" />

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="Green"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"
                       Style="{ThemeResource BaseTextBlockStyle}"/>

            <TextBlock Text="Talált Játékok:" 
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Margin="0,0,0,5"/>

            <ListView ItemsSource="{Binding FoundGames}" 
                      MaxHeight="200" 
                      SelectionMode="None"
                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding DisplayName}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource TextBlockButtonStyle}"
                                
                                Command="{Binding DataContext.JoinGameCommand, ElementName=RootGrid}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </Grid>
</local:BasePage>