<local:BasePage
    x:Class="Amoba.Views.GameTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="using:Amoba.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Válassz játékmódot"
                   Style="{ThemeResource TitleTextBlockStyle}" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,40"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Center"
                    MaxWidth="400">

            <Button
                x:Name="isVsPlayer" 
                Content="Játékos ellen" 
                FontSize="20" 
                Margin="0,0,0,20" 
                Command="{Binding IsVsPlayer}"
                
                MinHeight="50"
                
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                Foreground="White" />

            <Button
                x:Name="isVsComputer" 
                Content="Számítógép ellen" 
                FontSize="20" 
                Margin="0,0,0,20" 
                Command="{Binding IsVsComputer}"
                
                MinHeight="50"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                Foreground="White" />

        </StackPanel>
    </Grid>
</local:BasePage>