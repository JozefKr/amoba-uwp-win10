<Page
    x:Class="Amoba.Views.GameSizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="525">

    <Grid Width="450" Padding="0, 20, 0, 0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button 
                Height="70" Width="70" 
                Content="3" 
                Margin="0,0,30,0" 
                FontSize="30"  
                Command="{Binding SelectSize}" 
                CommandParameter="3"
                Style="{StaticResource AccentButtonStyle}" />
            <Button 
                Height="70" Width="70" 
                Content="4"  
                Margin="0,0,30,0" 
                FontSize="30" 
                Command="{Binding SelectSize}" 
                CommandParameter="4" 
                Style="{StaticResource AccentButtonStyle}" />

            <Button 
                Height="70" Width="70" 
                Content="5" 
                Margin="0,0,0,0" 
                FontSize="30" 
                Command="{Binding SelectSize}" 
                CommandParameter="5" 
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>